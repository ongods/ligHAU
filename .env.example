# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
# GitHub Pages uses MAPTILER_KEY; private backend values go in host secrets.

# --- Safe to ship in the app, and therefore safe to deploy -------------------
# Browser map key. Restrict allowed origins in MapTiler Cloud.
# Run tools/sync-map-config.ps1 to generate the public browser map asset.
# Never pass this entire file to Flutter: it also holds backend-only keys.
MAPTILER_KEY=put_your_maptiler_key_here
MAPTILER_STYLE_ID=streets-v4

# --- Backend only: never compile these into the browser app ------------------
# Keep these in local .env or backend-host secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_PORT=8787
# Direct local development stays on loopback; Docker sets 0.0.0.0 internally.
CHAT_HOST=127.0.0.1
# Hosted production: exact frontend origin, without a repository path.
CHAT_ALLOWED_ORIGINS=https://ongods.github.io
# Exact socket IPs of trusted HTTPS proxies; blank for direct local development.
# The trusted edge must overwrite X-Forwarded-Proto and X-Forwarded-For.
CHAT_TRUSTED_PROXY_ADDRESSES=
# direct for localhost/custom proxy; render only on a Render web service.
CHAT_HOSTING_PLATFORM=direct
# Backend-only: SQLite file on a persistent local disk/volume. Blank uses server/.local/campus.sqlite.
CAMPUS_DB_PATH=
# Choose sqlite for the existing local database or postgres for Supabase.
DATABASE_DRIVER=sqlite
# Backend-only SQL connection; use the restricted lighau_backend role after setup.
DATABASE_URL=
# Schema-owner URL used only by migration/role setup, never by the running API.
DATABASE_MIGRATION_URL=
# TLS verifies certificates by default. Set a CA file path if your project needs one.
DATABASE_CA_FILE=
DATABASE_POOL_SIZE=5
# Only a disposable loopback Postgres test DB may use disable; hosted DBs use TLS.
DATABASE_SSL=require
# Conservative free-tier controls; reference provider quotas can lower RPM/RPD caps.
CHAT_CLIENT_LIMIT=5
CHAT_GLOBAL_LIMIT=30
CHAT_DAILY_LIMIT=100
CHAT_RPM_LIMIT=5
# Optional reference limits: copy the limits for GEMINI_MODEL from AI Studio.
# Blank means unknown. These do not change the provider's actual quota.
GEMINI_QUOTA_RPM=
GEMINI_QUOTA_TPM=
GEMINI_QUOTA_RPD=
# Private service token from MapTiler Cloud > Credentials (NOT MAPTILER_KEY).
MAPTILER_SERVICE_TOKEN=
# Optional allowances for the current MapTiler account plan/billing period.
MAPTILER_QUOTA_REQUESTS=
MAPTILER_QUOTA_SESSIONS=
